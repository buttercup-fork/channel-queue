{
  "name": "@buttercup/channel-queue",
  "version": "2.0.0",
  "description": "A queue management library with channels",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "format": "prettier --write \"{source,test}/**/*.{js,ts}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:format",
    "test:format": "prettier --check \"{source,test}/**/*.{js,ts}\"",
    "test:unit": "mocha -r test/index.js 'test/unit/**/*.spec.js'"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttercup-fork/channel-queue.git"
  },
  "keywords": [
    "queue",
    "channel",
    "enqueue",
    "promise",
    "event",
    "emitter"
  ],
  "author": "Buttercup <info@buttercup.pw>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/buttercup/channel-queue/issues"
  },
  "homepage": "https://github.com/buttercup/channel-queue#readme",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "layerr": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "sleep-promise": "^9.1.0",
    "typescript": "^6.0.3"
  }
}
